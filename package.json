{
  "name": "@amjadiqbal/shopify-app-tanstack-start",
  "version": "0.1.0",
  "description": "Build embedded Shopify apps on TanStack Start: session tokens and token exchange, webhook and app proxy verification, billing, and App Bridge setup, as Start middleware and server routes. Community package, not affiliated with Shopify.",
  "keywords": [
    "shopify",
    "shopify-app",
    "shopify-api",
    "shopify-embedded-app",
    "app-bridge",
    "tanstack",
    "tanstack-start",
    "tanstack-router",
    "token-exchange",
    "session-token",
    "webhooks",
    "app-proxy",
    "shopify-billing"
  ],
  "homepage": "https://github.com/amjadiqbal/shopify-app-tanstack-start#readme",
  "bugs": "https://github.com/amjadiqbal/shopify-app-tanstack-start/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amjadiqbal/shopify-app-tanstack-start.git"
  },
  "license": "MIT",
  "author": {
    "name": "Amjad Iqbal",
    "url": "https://amjad.com.pk"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@shopify/admin-api-client": "^2.0.1",
    "@shopify/shopify-api": "^15.0.1",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "@shopify/storefront-api-client": "^2.0.1",
    "isbot": "^5.2.0"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.130.0",
    "@tanstack/react-start": "^1.130.0",
    "react": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@shopify/shopify-app-session-storage-memory": "8.0.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@types/node": "25.5.2",
    "@types/react": "19.3.0",
    "publint": "0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vitest-fetch-mock": "0.4.5"
  }
}
